{
  "name": "hdy-plugin",
  "version": "0.2.5-hdy.1",
  "description": "Prompt-polish button beside the composer model seat for DSH, porting linshenkx/prompt-optimizer's optimizationMode axis, mustache template engine, template registry and variable extraction.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./prompts": "./lib/prompts.js",
    "./processor": "./lib/processor.js",
    "./mustache": "./lib/mustache.js",
    "./extraction": "./lib/extraction.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.1.7-0",
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-llm": ">=0.1.7-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "compat.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2718930752/hdy-plugin.git"
  },
  "homepage": "https://github.com/2718930752/hdy-plugin#readme",
  "bugs": {
    "url": "https://github.com/2718930752/hdy-plugin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "prompt-optimizer",
    "deepseek-harness"
  ],
  "scripts": {
    "test": "node mustache.test.mjs && node smoke.mjs && node contract.test.mjs && node host.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "dev": "pwsh -File ./dev.ps1",
    "compat": "node compat.mjs"
  }
}
